# ---------------- Teacher Functions ----------------
def add_student():
    roll = int(input("Enter Roll No: "))
    name = input("Enter Name: ")
    dept = input("Enter Department: ")
    branch = input("Enter Branch: ")
    section = input("Enter Section: ")
    pwd = input("Set Password for Student: ")

    print("📷 Capturing face... Look at the camera")
    video = cv2.VideoCapture(0)
    face_encoding = None

    if not video.isOpened():
        print("❌ Cannot open webcam")
        return

    while True:
        ret, frame = video.read()
        if not ret or frame is None:
            continue

        if frame.dtype != np.uint8:
            frame = np.array(frame, dtype=np.uint8)

        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

        try:
            face_locations = face_recognition.face_locations(rgb_frame)
        except Exception as e:
            print("⚠️ Face detection error:", e)
            continue

        if face_locations:
            encodings = face_recognition.face_encodings(rgb_frame, face_locations)
            if encodings:
                face_encoding = encodings[0]
                top, right, bottom, left = face_locations[0]
                cv2.rectangle(frame, (left, top), (right, bottom), (0, 255, 0), 2)
                cv2.putText(frame, "Face Captured", (50, 50),
                            cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
                cv2.imshow("Register Face", frame)
                cv2.waitKey(2000)
                break

        cv2.imshow("Register Face", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    video.release()
    cv2.destroyAllWindows()

    if face_encoding is None:
        print("❌ Could not capture face. Student not added.\n")
        return

    encoding_bytes = face_encoding.tobytes()
    try:
        cursor.execute(
            "INSERT INTO students (roll_no, name, department, branch, section, password, face_encoding) "
            "VALUES (%s, %s, %s, %s, %s, %s, %s)",
            (roll, name, dept, branch, section, pwd, encoding_bytes)
        )
        con.commit()
        print("✅ Student added successfully with face data.\n")
    except mysql.connector.IntegrityError:
        print("❌ Roll No already exists.\n")

def load_known_faces():
    cursor.execute("SELECT roll_no, name, face_encoding FROM students WHERE face_encoding IS NOT NULL")
    data = cursor.fetchall()
    known_encodings, known_names, known_rolls = [], [], []

    for row in data:
        roll, name, encoding_bytes = row
        if encoding_bytes:
            encoding = np.frombuffer(encoding_bytes, dtype=np.float64)
            known_encodings.append(encoding)
            known_names.append(name)
            known_rolls.append(roll)

    return known_encodings, known_names, known_rolls

def mark_attendance_by_camera():
    known_encodings, known_names, known_rolls = load_known_faces()

    if not known_encodings:
        print("⚠️ No face data found. Please register students first.")
        return

    video = cv2.VideoCapture(0)
    if not video.isOpened():
        print("❌ Cannot open webcam")
        return

    print("📷 Camera started. Press 'q' to quit.")

    while True:
        ret, frame = video.read()
        if not ret or frame is None:
            continue

        if frame.dtype != np.uint8:
            frame = np.array(frame, dtype=np.uint8)

        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

        try:
            face_locations = face_recognition.face_locations(rgb_frame)
            face_encodings = face_recognition.face_encodings(rgb_frame, face_locations)
        except Exception as e:
            print("⚠️ Face detection error:", e)
            continue

        for (top, right, bottom, left), face_encoding in zip(face_locations, face_encodings):
            matches = face_recognition.compare_faces(known_encodings, face_encoding, tolerance=0.5)
            face_distances = face_recognition.face_distance(known_encodings, face_encoding)
            best_match = np.argmin(face_distances)

            if matches[best_match]:
                roll = known_rolls[best_match]
                name = known_names[best_match]

                today = datetime.date.today()
                cursor.execute("SELECT * FROM attendance WHERE roll_no=%s AND date=%s", (roll, today))
                if cursor.fetchone():
                    msg = f"{name} ({roll}) already marked."
                else:
                    cursor.execute(
                        "INSERT INTO attendance (roll_no, date, status) VALUES (%s, %s, %s)",
                        (roll, today, "Present")
                    )
                    con.commit()
                    msg = f"✅ Marked Present: {name} ({roll})"

                cv2.rectangle(frame, (left, top), (right, bottom), (0, 255, 0), 2)
                cv2.putText(frame, msg, (left, top - 10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)

        cv2.imshow("Attendance Camera", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    video.release()
    cv2.destroyAllWindows()

def add_attendance():
    att_date_str = input("Enter date (YYYY-MM-DD): ")
    att_date = datetime.datetime.strptime(att_date_str, "%Y-%m-%d").date()
    today = datetime.date.today()

    if att_date < today:
        print("❌ You cannot add attendance for past dates.\n")
        return

    cursor.execute("SELECT * FROM students")
    students = cursor.fetchall()

    if not students:
        print("⚠️ No students found. Please add students first.\n")
        return

    for s in students:
        roll, name, dept, branch, section, pwd, face_enc = s
        cursor.execute("SELECT status FROM attendance WHERE roll_no=%s AND date=%s", (roll, att_date))
        result = cursor.fetchall()

        if result:
            old_status = result[0][0]
            print(f"Attendance already exists for {name} ({roll}) on {att_date}. Status = {old_status}")
            update_choice = input("Do you want to update it? (Y/N): ").strip().upper()
            if update_choice != 'Y':
                continue

            while True:
                status = input(f"Update attendance for {name} ({roll}) - P=Present, A=Absent, L=Leave: ").strip().upper()
                if status in ['P', 'A', 'L']:
                    break
                print("❌ Invalid input!")

            cursor.execute(
                "UPDATE attendance SET status=%s WHERE roll_no=%s AND date=%s",
                (("Present" if status == 'P' else "Absent" if status == 'A' else "Leave"), roll, att_date)
            )
            con.commit()
            print(f"✅ Attendance updated for {name} ({roll}) on {att_date}\n")

        else:
            while True:
                status = input(f"Mark attendance for {name} ({roll}) - P=Present, A=Absent, L=Leave: ").strip().upper()
                if status in ['P', 'A', 'L']:
                    break
                print("❌ Invalid input!")

            cursor.execute(
                "INSERT INTO attendance (roll_no, date, status) VALUES (%s,%s,%s)",
                (roll, att_date, "Present" if status == 'P' else "Absent" if status == 'A' else "Leave")
            )
            con.commit()
            print(f"✅ Attendance added for {name} ({roll}) on {att_date}\n")

def check_attendance_teacher():
    cursor.execute("SELECT DISTINCT date FROM attendance ORDER BY date")
    working_days = cursor.fetchall()

    valid_days = 0
    for d in working_days:
        cursor.execute("SELECT COUNT(*) FROM attendance WHERE date=%s AND status IN ('Present','Absent')", (d[0],))
        if cursor.fetchone()[0] > 0:
            valid_days += 1

    cursor.execute("""
        SELECT s.roll_no, s.name, s.department, s.branch, s.section,
               COUNT(CASE WHEN a.status='Present' THEN 1 END)
        FROM students s
        LEFT JOIN attendance a ON s.roll_no=a.roll_no
        GROUP BY s.roll_no, s.name, s.department, s.branch, s.section
    """)
    records = cursor.fetchall()

    print("\n--- Attendance Report ---")
    for r in records:
        roll, name, dept, branch, section, present_days = r
        percent = (present_days / valid_days * 100) if valid_days > 0 else 0
        status_msg = " Short (<75%)" if percent < 75 else " OK (>=75%)"
        print(f"Roll: {roll}, Name: {name}, Dept: {dept}, Branch: {branch}, Sec: {section}, "
              f"Present: {present_days}, Total: {valid_days}, %: {percent:.2f} --> {status_msg}")
    print()

